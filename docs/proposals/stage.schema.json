{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consequence-atlas.org/schema/v0/stage.schema.json",
  "title": "Atlas stage (PROPOSAL, not yet committed to schema/)",
  "type": "object",
  "required": ["id", "name", "order", "requires"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"},
    "name": {"type": "string"},
    "order": {"type": "integer", "minimum": 0},
    "requires": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"}},
    "notes": {"type": "string"}
  }
}
