{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consequence-atlas.org/schema/v0/dial.schema.json",
  "title": "Dial",
  "type": "object",
  "required": [
    "id",
    "name",
    "units",
    "ours",
    "range",
    "scale"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "units": {
      "type": "string"
    },
    "ours": {
      "type": "number"
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "scale": {
      "enum": [
        "linear",
        "log",
        "discrete"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
      }
    }
  }
}