{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consequence-atlas.org/schema/v0/meaning.schema.json",
  "title": "Meaning",
  "type": "object",
  "required": [
    "id",
    "symbol",
    "definition",
    "author"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 10
    },
    "formal": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "same_as": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}